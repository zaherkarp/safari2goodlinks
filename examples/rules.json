{
  "throttle_ms": 50,
  "group_tag_format": "tg/{group}",
  "active_mode_group_name": "active",

  "skip_url_prefixes": [
    "about:",
    "file:",
    "safari-extension:",
    "chrome-extension:",
    "javascript:",
    "data:",
    "mailto:",
    "tel:",
    "sms:",
    "facetime:"
  ],
  "skip_url_regex": [
    "^(https?://)?localhost[:/]"
  ],

  "domain_tags": {
    "github.com": ["dev"],
    "bitbucket": ["dev"],
    "docs.google.com": ["docs"],
    "stackoverflow.com": ["dev"],
    "cms.gov": ["cms"],
    "ncqa.org": ["ncqa"],
    "arxiv.org": ["papers"],
    ".gov": ["gov"],
    ".edu": ["edu"]
  },

  "keyword_tags": [
    { "pattern": "\\brfc\\b", "fields": ["title", "url"], "tags": ["rfc"] },
    { "pattern": "\\bchangelog\\b|\\brelease\\b", "fields": ["title"], "tags": ["release-notes"] },
    { "pattern": "\\bapi\\b|\\bsdk\\b|\\bdocs\\b|\\bdocumentation\\b", "fields": ["title"], "tags": ["docs"] },
    { "pattern": "\\btutorial\\b|\\bhow.to\\b|\\bguide\\b", "fields": ["title"], "tags": ["tutorial"] },
    { "pattern": "\\bvideo\\b|youtube\\.com|vimeo\\.com", "fields": ["title", "url"], "tags": ["video"] }
  ],

  "triage": {
    "vault_path": "~/Library/Mobile Documents/iCloud~md~obsidian/Documents/Wintermute",
    "note_inbox": "Tab inbox.md",
    "bookmark_inbox": "bookmarks/Bookmarks inbox.md",
    "triage_file": "~/Documents/stg2gl/triage.md",
    "ledger": "~/.stg2gl/ledger.db",
    "bookmarks_html_dir": "~/Downloads",
    "bookmark_bare_domains": true,

    "auto_route": true,
    "close_tabs": true,
    "close_tabs_keep_domains": [],
    "learn": { "enabled": true, "min_count": 3, "min_share": 0.8 },
    "page_hints": "off",
    "page_hints_max": 150,

    "sources": {
      "windows": true,
      "tab_groups": { "method": "db", "names": [], "exclude": [] },
      "icloud": { "enabled": true, "exclude_devices": [] }
    },

    "category_rules": [
      { "category": "skip", "why": "login, account or checkout page", "auto": true,
        "url_regex": "/(login|log-in|signin|sign-in|signup|logout|checkout|cart|account|oauth)(/|\\?|$)" },
      { "category": "skip", "why": "search results", "auto": true,
        "url_regex": "(google\\.[a-z.]+/search|bing\\.com/search|duckduckgo\\.com/\\?q=|kagi\\.com/search)" },
      { "category": "skip", "why": "web app, not content", "auto": true,
        "domains": ["mail.google.com", "calendar.google.com", "icloud.com", "web.whatsapp.com"] },

      { "category": "unsorted", "why": "Google Docs file: decide by hand",
        "domains": ["docs.google.com", "drive.google.com"] },

      { "category": "note", "why": "Q&A answer: keep the fact", "auto": true,
        "domains": ["stackoverflow.com", "stackexchange.com", "superuser.com", "serverfault.com", "askubuntu.com"] },
      { "category": "note", "why": "encyclopedia entry",
        "domains": ["wikipedia.org"] },
      { "category": "note", "why": "recipe",
        "title_regex": "\\brecipes?\\b" },

      { "category": "bookmark", "why": "shop (place, not thing)", "auto": true,
        "domains": ["rei.com", "etsy.com", "jetpens.com", "countycomm.com", "humangear.com", "mightyedc.com"] },
      { "category": "bookmark", "why": "documentation site",
        "domains": ["docs.", "readthedocs.io", "developer.apple.com", "developer.mozilla.org"] },

      { "category": "read", "why": "paper", "auto": true,
        "domains": ["arxiv.org", "ssrn.com", "biorxiv.org"] },
      { "category": "read", "why": "newsletter or blog platform",
        "domains": ["substack.com", "medium.com", "ghost.io", "beehiiv.com"] },
      { "category": "read", "why": "video to watch",
        "url_regex": "(youtube\\.com/watch|youtu\\.be/|vimeo\\.com/\\d+)" },
      { "category": "read", "why": "article-style path",
        "url_regex": "/(blog|posts?|articles?|essays?|p|news|story)/[^/?#]+" },
      { "category": "read", "why": "dated path",
        "url_regex": "/20\\d\\d/\\d\\d/" }
    ]
  }
}
